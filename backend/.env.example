NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=pokelap
JWT_SECRET=pokelap-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
# Código opcional: si un usuario lo envía en el registro, su cuenta se crea como admin.
# Si se deja vacío, nadie puede auto-registrarse como admin.
ADMIN_INVITE_CODE=
# Orígenes CORS permitidos (separados por comas). Vacío = permitir todo solo en desarrollo.
CORS_ORIGINS=http://localhost:8081
# Almacenamiento de archivos en Vercel Blob.
# Autenticación preferente: OIDC (VERCEL_OIDC_TOKEN, rotado por Vercel). Local: `vercel env pull`.
# Alternativa: token de lectura/escritura BLOB_READ_WRITE_TOKEN.
VERCEL_OIDC_TOKEN=
BLOB_STORE_ID=