{
  "expo": {
    "name": "PokerPros Admin",
    "slug": "pokerpro-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "PokerProsadmin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nexosoftware.pokerprosmanagement.ve",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Esta app usa la cámara para tomar la foto de perfil de jugadores y del club.",
        "NSPhotoLibraryUsageDescription": "Esta app accede a tu galería para elegir la foto de perfil de jugadores y del club.",
        "NSLocalNetworkUsageDescription": "Esta app se conecta a la red local (WiFi) para consultar las mesas y torneos del club."
      }
    },
    "android": {
      "package": "nexosoftware.pokerprosmanagement.ve",
      "adaptiveIcon": {
        "backgroundColor": "#3EA1FF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "CHANGE_NETWORK_STATE",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B1C1D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 658,
          "resizeMode": "cover"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a PokerPros Admin acceder a tus fotos para elegir la imagen de perfil de jugadores y del club.",
          "cameraPermission": "Permite a PokerPros Admin usar la cámara para tomar la foto de perfil de jugadores y del club.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "owner": "gustavosant",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd36c178-a6ee-477d-a1d5-dc03ff98ca44"
      }
    }
  }
}